+         *
+         * The bypass ring is drained exclusively by the CoreAudio IOProc,
+         * so it must stay inactive for any other backend (e.g. the wav
+         * audiodev); otherwise TX buffers never return and no PCM ever
+         * reaches the backend. Non-CoreAudio backends take the normal
+         * AUD_write/mixeng path.
          */
         bool bypass_ok = (as.nchannels == 2 &&
                           (as.fmt == AUDIO_FORMAT_F32 ||
                            as.fmt == AUDIO_FORMAT_S32) &&
-                          host_audio_bypass_ready());
+                          host_audio_bypass_ready()) &&
+                         audio_be_is_coreaudio(s->audio_be);
         if (bypass_ok) {
             vsnd_drain_target_dev = s;
             virtio_snd_bypass_set_active(1, as.fmt, (uint32_t)as.freq);
