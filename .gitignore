# Build outputs. build/ also holds the files that come from YOUR deck
# (build/pulled/) and your per-install SSH key (build/ssh/): never commit them.
build/
guest/out/
target/

AZ-EMU.app/

# Audio the emulator recorded (AZ_AUDIO=file, tools/az-capture.py).
audio-out-captures/
dist/

# QEMU: track only the build script, the patches and the license.
qemu/*
!qemu/build.sh
!qemu/patches
!qemu/LICENSE

# Keys of any kind never belong in this repository.
*.key
*.pem
id_*

# Python
__pycache__/
*.pyc

# macOS
.DS_Store
